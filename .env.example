# Repository and host storage paths
PROJECT_ROOT=/data/devops/iot-devops
RUNTIME_ROOT=/data/devops/runtime
ARTIFACT_ROOT=/data/devops/artifacts
# Host-specific group ID of /var/run/docker.sock; scripts/start.sh detects it.
DOCKER_GID=991

# Network endpoints
GITLAB_EXTERNAL_URL=http://192.168.100.60:8929
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
DINGTALK_TOKEN_FILE=/data/devops/secrets/dingtalk_token
MQTT_PORT=1883
NGINX_PORT=8081
GRAFANA_PORT=3000
SONARQUBE_PORT=9000
POSTGRES_PORT=5432

# Replace these values in /data/devops/secrets/iot-devops.env
INFLUXDB_USERNAME=CHANGE_ME
INFLUXDB_PASSWORD=CHANGE_ME
INFLUXDB_ORG=iot-org
INFLUXDB_BUCKET=iot-telemetry
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_RETENTION=30d
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=CHANGE_ME
